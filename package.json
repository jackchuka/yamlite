{
  "name": "@jackchuka/yamlite",
  "version": "0.0.0",
  "description": "Sync YAML files and SQLite in both directions",
  "keywords": [
    "cli",
    "database",
    "git",
    "sqlite",
    "sync",
    "watch",
    "yaml"
  ],
  "homepage": "https://github.com/jackchuka/yamlite#readme",
  "bugs": "https://github.com/jackchuka/yamlite/issues",
  "license": "MIT",
  "author": "jackchuka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackchuka/yamlite.git"
  },
  "bin": {
    "yamlite": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --config ui/playwright.config.ts",
    "i18n": "node ui/compile-i18n.ts",
    "typecheck": "pnpm i18n && tsc -p . && tsc -p ui",
    "lint": "oxlint --deny-warnings && pnpm lint:i18n && oxfmt --check",
    "lint:i18n": "oxlint -c ui/oxlint.i18n.json --deny-warnings ui/src",
    "lint:fix": "oxlint --fix && oxfmt",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.13",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@uiw/react-codemirror": "4.25.12",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "jsdom": "30.1.1",
    "lucide-react": "1.49.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx-expression": "2.0.1",
    "mdast-util-mdx-jsx": "3.2.0",
    "micromark-extension-mdx": "2.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "sql.js": "1.14.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.16"
  },
  "packageManager": "pnpm@12.6.0"
}
